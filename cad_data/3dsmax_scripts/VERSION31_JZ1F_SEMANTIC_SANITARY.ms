/* JZ1F semantic + sanitary add-on; VERSION31 (2) reference, Z-up CAD numeric coordinates.
   Adds only. Re-run replaces ONLY objects created by this script.
   Furniture dimensions are low-poly approximations, not manufacturer models. */
(
local makeReviewFixtures = false
local makeLabels = true
local makeStallPanels = true
local floorNode = getNodeByName "DQ1F_SLAB_FLOOR_PREVIEW_001"
if floorNode == undefined then (messageBox "Open the VERSION31 scene first. Floor reference not found." title:"JZ1F" ) else (
local b = nodeGetBoundingBox floorNode (matrix3 1)
if ((abs(b[1].x - 268347.78125) > 150.0) or (abs(b[1].y - 417794.1875) > 150.0) or (abs(b[2].z) > 150.0)) then (messageBox "Floor reference coordinates differ from VERSION31. No changes made." title:"JZ1F") else (
undo "JZ1F semantics and sanitary fixtures" on (
local prior = for o in objects where (getUserProp o "JZ1F_ADDON") == "JZ1F_V1" collect o
if prior.count > 0 do delete prior
local fixtureLayer = LayerManager.getLayerFromName "JZ1F_SANITARY"
if fixtureLayer == undefined do fixtureLayer = LayerManager.newLayerFromName "JZ1F_SANITARY"
local labelLayer = LayerManager.getLayerFromName "JZ1F_ROOM_LABELS"
if labelLayer == undefined do labelLayer = LayerManager.newLayerFromName "JZ1F_ROOM_LABELS"
local reviewLayer = LayerManager.getLayerFromName "JZ1F_REVIEW"
if reviewLayer == undefined do reviewLayer = LayerManager.newLayerFromName "JZ1F_REVIEW"
local ceramic = standardMaterial name:"JZ1F_Ceramic" diffuse:(color 240 240 235)
local o = undefined
local txt = undefined
local layerRef = undefined
